# SuperTeacher backend — local environment file. NEVER commit this file.
# Copy to .env and fill in real values.

# --- Database (PostgreSQL) -------------------------------------------
DB_NAME=super_teacher_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=super_admin
DB_PASSWORD=change-me
# Alternative: full database URL (overrides DB_* vars above)
# DATABASE_URL=postgresql+psycopg://user:pass@host:port/dbname

# --- Security ---------------------------------------------------------
# Generate a real secret for any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Password policy ---------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- Token lifetimes ---------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Sessions ----------------------------------------------------------
MAX_SESSIONS_PER_USER=10

# --- CORS (production MUST set explicit origins, no wildcards) ---------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (format: "<max_requests>/<period>") -----------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_STUDENT_READ=30/minute
RATE_LIMIT_STUDENT_WRITE=10/minute
RATE_LIMIT_STUDENT_HISTORY=30/minute

# --- Connection pool tuning --------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Email (Resend API) -----------------------------------------------
RESEND_API_KEY=re_change-me
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Frontend ----------------------------------------------------------
# URL where password reset links point (e.g. http://localhost:5173/reset-password)
FRONTEND_URL=http://localhost:5173

# --- Application ------------------------------------------------------
# development | testing | production
ENVIRONMENT=development
