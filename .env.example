# SuperTeacher backend — local environment file. NEVER commit this file.
# Copy to .env and fill in real values.

# --- Database (PostgreSQL) -------------------------------------------
DB_NAME=super_teacher_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=super_admin
DB_PASSWORD=change-me
# Alternative: full database URL (overrides DB_* vars above)
# DATABASE_URL=postgresql+psycopg://user:pass@host:port/dbname

# --- Security ---------------------------------------------------------
# Generate a real secret for any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Password policy ---------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- Token lifetimes ---------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Sessions ----------------------------------------------------------
MAX_SESSIONS_PER_USER=10

# --- CORS (production MUST set explicit origins, no wildcards) ---------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (format: "<max_requests>/<period>") -----------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_ME_READ=60/minute
RATE_LIMIT_STUDENT_READ=30/minute
RATE_LIMIT_STUDENT_WRITE=10/minute
RATE_LIMIT_STUDENT_HISTORY=30/minute
RATE_LIMIT_HEALTH=120/minute
RATE_LIMIT_CHANGE_PASSWORD=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_DEACTIVATE_ACCOUNT=5/minute
RATE_LIMIT_REGISTRATION_READ=30/minute
RATE_LIMIT_REGISTRATION_WRITE=10/minute

# slowapi storage backend. "memory://" is PER-PROCESS: each worker keeps its
# own counters, so a 4-worker deployment effectively allows 4x the limit above.
# Multi-worker/production deployments must point this at a shared store
# (e.g. redis://host:6379) — slowapi loads the matching backend from the URI,
# no extra dependency is required just to configure it.
RATE_LIMIT_STORAGE_URI=memory://

# --- Login lockout ------------------------------------------------------
# Refused attempts before the account is locked, and the lock duration.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# --- Connection pool tuning --------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Email (Resend API) -----------------------------------------------
RESEND_API_KEY=re_change-me
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Frontend ----------------------------------------------------------
# URL where password reset links point (e.g. http://localhost:5173/reset-password)
FRONTEND_URL=http://localhost:5173

# --- Application ------------------------------------------------------
# development | testing | production
ENVIRONMENT=development

# Log verbosity applied once at startup (app.core/logging.py).
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
